{
    "name": "prostor-app",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --port 3050",
        "dev:https": "next dev --port 3050 --experimental-https",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "lint:fsd": "steiger ./src",
        "test": "NODE_OPTIONS='--experimental-require-module' vitest run",
        "test:watch": "NODE_OPTIONS='--experimental-require-module' vitest",
        "test:coverage": "NODE_OPTIONS='--experimental-require-module' vitest run --coverage",
        "prepare": "husky"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.9",
        "@heroicons/react": "^2.2.0",
        "@hookform/resolvers": "^5.2.2",
        "@tanstack/react-query": "^5.90.21",
        "@tma.js/sdk-react": "^3.0.16",
        "@turf/turf": "^7.3.4",
        "aria-query": "^5.3.2",
        "broad-infinite-list": "^1.4.1",
        "clsx": "^2.1.1",
        "daisyui": "^5.5.19",
        "date-fns": "^4.1.0",
        "maplibre-gl": "^5.20.1",
        "next": "16.1.6",
        "react": "19.2.3",
        "react-datepicker": "^9.1.0",
        "react-dom": "19.2.3",
        "react-hook-form": "^7.71.2",
        "react-intersection-observer": "^10.0.3",
        "react-map-gl": "^8.1.0",
        "react-markdown": "^10.1.0",
        "react-toastify": "^11.0.5",
        "react-virtuoso": "^4.18.3",
        "react-zoom-pan-pinch": "^3.7.0",
        "swiper": "^12.1.2",
        "tailwind-merge": "^3.5.0",
        "zod": "^4.3.6",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@feature-sliced/steiger-plugin": "^0.5.7",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/postcss": "^4",
        "@tailwindcss/typography": "^0.5.19",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/eslint-plugin": "^8.57.0",
        "eslint": "^9",
        "eslint-config-next": "16.1.6",
        "happy-dom": "^20.8.4",
        "husky": "^9.1.7",
        "lint-staged": "^16.3.3",
        "msw": "^2.12.11",
        "prettier": "^3.8.1",
        "steiger": "^0.5.11",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^3.2.4"
    },
    "browserslist": "> 1%",
    "lint-staged": {
        "*.{ts,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,css,md}": [
            "prettier --write"
        ]
    }
}
