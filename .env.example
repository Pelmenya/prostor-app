# ─── API ─────────────────────────────────────────────────────
# URL бэкенда (NestJS). На проде — внутренний DNS Docker-сети или внешний URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── Web App ─────────────────────────────────────────────────
# Публичный URL фронтенда (для magic link'ов, OG-тегов, PWA)
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3050

# ─── S3 ──────────────────────────────────────────────────────
# Публичный URL S3-хранилища для файлов (фото товаров, аватары)
NEXT_PUBLIC_S3_PUBLIC_URL=

# ─── Docker ──────────────────────────────────────────────────
# Порт контейнера на хосте (маппинг HOST:3000)
PORT_APP=3000

# ─── Dev ─────────────────────────────────────────────────────
# Разрешённые origins для dev-сервера (через запятую)
NEXT_PUBLIC_ALLOWED_DEV_ORIGINS=
