# ─── API ─────────────────────────────────────────────────────
# URL бэкенда в браузере. В Docker за gateway используется same-origin путь /api
NEXT_PUBLIC_API_URL=/api

# Внутренний URL бэкенда для SSR/ISR внутри общей Docker-сети
INTERNAL_API_URL=http://crm-back:3000

# Доступный во время Docker build URL бэкенда для prerender/ISR
BUILD_API_URL=

# URL slovo-api в браузере. Gateway перенаправляет этот путь в smart-search
NEXT_PUBLIC_SLOVO_API_URL=/smart-search

# Внутренний URL slovo-api для серверного рендеринга Next.js
INTERNAL_SLOVO_API_URL=http://slovo-api:3101

# Доступный во время Docker build URL slovo-api, если build запрашивает его данные
BUILD_SLOVO_API_URL=

# Публичный URL S3-хранилища (для вложений чата: изображения, файлы)
NEXT_PUBLIC_S3_PUBLIC_URL=

# ─── Каталог ─────────────────────────────────────────────────
# Типы цен для акционных цен (разделитель __)
NEXT_PUBLIC_SALE_PRICES=Приложение

# Процент комиссии, отображаемый во фронтенде
NEXT_PUBLIC_COMMISSION_PERCENTS=35

# ─── Web Push (VAPID) ────────────────────────────────────────
# Публичный VAPID ключ для push-уведомлений
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# 1 включает мок умного поиска; на сервере должен быть 0
NEXT_PUBLIC_SMART_SEARCH_MOCK=0

# ─── Docker ──────────────────────────────────────────────────
# Базовый Node-образ. На Timeweb: dockerhub.timeweb.cloud/library/node:22.16-slim
NODE_IMAGE=node:22.16-slim

# Порт контейнера на хосте (маппинг HOST:3000)
PORT_APP=3010

# ─── DEV ONLY (не нужны в Docker-образе) ─────────────────────
# Разрешённые origins для dev-сервера (через запятую)
NEXT_PUBLIC_ALLOWED_DEV_ORIGINS=
# Публичный URL фронтенда (для тестов)
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3050
# ID пользователя для dev-токена
NEXT_PUBLIC_DEV_USER_ID=
# ID администраторов Telegram (через __)
NEXT_PUBLIC_ADMIN_IDS=
